# =================================================================
# YUVA ENERGY PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================

# Database Connection (PostgreSQL 18+ with PostGIS 3.6+)
DATABASE_HOST=localhost
DATABASE_PORT=55432
DATABASE_NAME=yuva_dev
DATABASE_USER=yuva_test_admin
DATABASE_PASSWORD=yuva_dev_secret_2026

# Security & Authentication (JWT + PBKDF2-HMAC-SHA256)
JWT_SECRET_KEY=replace_with_a_cryptographically_secure_256bit_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Ingestion Pipeline Modes: REAL_DATA, TEST_FIXTURE, SIMULATION
DATA_MODE=REAL_DATA

# External Provider Endpoints & Rate Limits
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
ISRIC_SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
COPERNICUS_API_URL=https://catalogue.dataspace.copernicus.eu/resto/api/collections/Sentinel2/search.json

# Solar & Agronomic Constants
DEFAULT_SOLAR_PANEL_KW=5.0
DEFAULT_PUMP_EFFICIENCY=0.82
LOCAL_GRID_TARIFF_INR_PER_KWH=8.50
LOCAL_DIESEL_COST_INR_PER_LITER=90.00
